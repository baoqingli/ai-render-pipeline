# Copy to .env and adjust as needed. All settings use the ARP_ prefix.
# LLM: GLM API (spec D4 Phase 1 default). Self-hosted vLLM is a switch option
# (point ARP_LLM_BASE_URL back at the vLLM endpoint and empty ARP_LLM_API_KEY).
ARP_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ARP_LLM_MODEL=glm-5.3
ARP_LLM_API_KEY=
ARP_COMFY_URL=http://localhost:8188
ARP_WORKSPACE_DIR=experiments
ARP_REGISTRY_DB_URL=sqlite+aiosqlite:///./registry.db
ARP_GEMINI_API_KEY=
ARP_OPENAI_API_KEY=
