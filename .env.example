# Copy to .env and adjust as needed. All settings use the ARP_ prefix.
# LLM: GLM API (spec D4 Phase 1 default). Self-hosted vLLM is a switch option
# (point ARP_LLM_BASE_URL back at the vLLM endpoint and empty ARP_LLM_API_KEY).
# Supported GLM forms: /api/paas/v4/ = 按量付费（OpenAI 协议，ChatOpenAI）；
# /api/anthropic = 套餐协议端点（Anthropic 协议，需 langchain-anthropic）。
ARP_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ARP_LLM_MODEL=glm-5.3
ARP_LLM_API_KEY=
ARP_COMFY_URL=http://localhost:8188
ARP_WORKSPACE_DIR=experiments
# e2e 服务栈（deploy/docker-compose.services.yml）——DSN 写法差异见 docs/e2e-2026-09.md §1：
# SQLAlchemy 用 postgresql+psycopg（async 原生）；langgraph AsyncPostgresSaver 用裸 postgresql://
ARP_PG_DSN=postgresql+psycopg://arp:arp@localhost:5432/arp
ARP_VALKEY_URL=redis://localhost:6379/0
ARP_REGISTRY_DB_URL=sqlite+aiosqlite:///./registry.db
ARP_GEMINI_API_KEY=
ARP_OPENAI_API_KEY=
